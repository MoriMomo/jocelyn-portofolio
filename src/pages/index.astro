---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import InfoStrip from '../components/InfoStrip.astro';
import Manifesto from '../components/Manifesto.astro';
import Highlights from '../components/Highlights.astro';
import WorkList from '../components/WorkList.astro';
import About from '../components/About.astro';

const workEntries = await getCollection('work');
---

<Base
  title="Jocelyn Lau — Business Strategy, Consulting & Leadership Portfolio"
  description="Executive portfolio of Jocelyn Lau, International Business Management student at BINUS University specializing in B2B consulting, export strategy, and student leadership."
>
  <Hero />
  <InfoStrip />
  <Manifesto />
  <Highlights />
  <WorkList entries={workEntries} />
  <About />
</Base>
