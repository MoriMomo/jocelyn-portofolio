---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import InfoStrip from '../components/InfoStrip.astro';
import Manifesto from '../components/Manifesto.astro';
import Highlights from '../components/Highlights.astro';
import WorkList from '../components/WorkList.astro';
import About from '../components/About.astro';

const workEntries = await getCollection('work');
---

<Base
  title="Jocelyn Lau — Business Strategy & Consulting Portfolio"
  description="Portfolio of Jocelyn Lau, BINUS International Business Management scholar and Singapore international case finalist, open for 2026 strategy and consulting internships."
>
  <Hero />
  <InfoStrip />
  <Manifesto />
  <Highlights />
  <WorkList entries={workEntries} />
  <About />
</Base>
