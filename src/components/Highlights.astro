---
import Dither from './Dither.astro';

const groups = [
  {
    id: 'competitions',
    label: '01 / Competitions',
    cards: [
      {
        metric: '2nd Place',
        tag: 'National & International',
        title: 'Indonesian Representative in Singapore',
        detail:
          'Co-created AquiPlan export innovation for Australia; placed 2nd nationally and competed at the International Finals in Singapore.',
        accent: 'cream',
      },
      {
        metric: '3rd Place',
        tag: 'Business Case Competition',
        title: 'DWDG BINUS Case Winner & 5th at BICON',
        detail:
          'Developed the HEXAGON Gen Z ecosystem strategy for ParagonCorp (#3 Winner) and C2M retail demand strategy for Crystalin (#5 Finalist).',
        accent: 'cream',
      },
    ],
  },
  {
    id: 'organizations',
    label: '02 / Organizations & Leadership',
    cards: [
      {
        metric: '40 Students',
        tag: 'Project Leadership',
        title: 'Project Leader: The Little Visionaries',
        detail:
          'Directed 40 university students across multiple divisions to deliver youth career and creative workshops at Yayasan Sosial Tangan Kasih.',
        accent: 'blue',
      },
      {
        metric: '80 Members',
        tag: 'Organizational Founding',
        title: 'Founded 2 Student Organizations',
        detail:
          'Established the 80-member, 10-division school Fellowship Community and founded the 7-group Business & Competition Prep Club.',
        accent: 'blue',
      },
    ],
  },
];
---

<section id="highlights" class="highlights surface-light" aria-labelledby="highlights-heading">
  <div class="highlights__bg" aria-hidden="true">
    <Dither
      palette={['#E6F1FA', '#9CC5EC', '#5798D7', '#2B6CB0', '#B9C255']}
      ditherMode="bayer"
      pixelSize={3}
      waveSpeed={0.05}
      waveFrequency={2.8}
      waveAmplitude={0.34}
      scale={1.05}
      contrast={1.25}
      brightness={0.08}
      mouseEffect="ripple"
      mouseRadius={0.46}
      mouseStrength={1.25}
      trail={0.62}
      clickRipple={true}
    />
  </div>

  <div class="container highlights__inner">
    <div class="highlights__header" data-reveal="up">
      <p class="eyebrow">Quantifiable Impact</p>
      <h2 id="highlights-heading" class="serif-heading highlights__title" data-reveal="lines">
        Track Record at a Glance
      </h2>
    </div>

    <div class="highlights__groups">
      {
        groups.map((group) => (
          <div class="highlights__group" data-reveal="up">
            <h3 class="highlights__group-label">{group.label}</h3>
            <div class="highlights__grid">
              {group.cards.map((card) => (
                <article
                  class:list={['highlight-card', `highlight-card--${card.accent}`]}
                  data-reveal="up"
                >
                  <div class="highlight-card__top">
                    <span class="tabular serif-heading highlight-card__metric">{card.metric}</span>
                    <span class="highlight-card__tag">{card.tag}</span>
                  </div>
                  <h4 class="highlight-card__heading">{card.title}</h4>
                  <p class="highlight-card__detail">{card.detail}</p>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .highlights {
    padding-block: var(--space-xl);
    position: relative;
    overflow: hidden;
  }

  .highlights__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.88;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 10%,
      #000 22%,
      #000 78%,
      rgba(0, 0, 0, 0.35) 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 10%,
      #000 22%,
      #000 78%,
      rgba(0, 0, 0, 0.35) 90%,
      transparent 100%
    );
  }

  .highlights__inner {
    position: relative;
    z-index: 1;
  }

  .highlights__header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: var(--space-lg);
  }

  .highlights__header .eyebrow {
    align-self: flex-start;
    background-color: rgba(230, 241, 250, 0.78);
    backdrop-filter: blur(4px);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    color: var(--color-navy);
    font-weight: 600;
  }

  .highlights__title {
    font-size: var(--step-3);
    paint-order: stroke fill;
    -webkit-text-stroke: 0.08em var(--color-frost);
  }

  .highlights__groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .highlights__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .highlights__group-label {
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-navy);
    background-color: rgba(230, 241, 250, 0.86);
    backdrop-filter: blur(4px);
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    border-bottom: 2px solid rgba(18, 35, 54, 0.22);
    align-self: stretch;
  }

  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .highlight-card {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid rgba(18, 35, 54, 0.14);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .highlight-card--cream {
    background-color: var(--color-navy);
    border: 1px solid rgba(87, 152, 215, 0.45);
    border-top: 4px solid var(--color-denim);
    color: var(--color-frost);
    box-shadow: 0 14px 32px rgba(18, 35, 54, 0.14);
  }

  .highlight-card--blue {
    background-color: var(--color-pistachio);
    border: 1px solid rgba(18, 35, 54, 0.28);
    border-top: 4px solid var(--color-navy);
    color: var(--color-navy);
    box-shadow: 0 14px 32px rgba(18, 35, 54, 0.1);
  }

  .highlight-card__top {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--border-hairline);
  }

  .highlight-card--cream .highlight-card__top {
    border-bottom-color: rgba(230, 241, 250, 0.18);
  }

  .highlight-card--blue .highlight-card__top {
    border-bottom-color: rgba(18, 35, 54, 0.2);
  }

  .highlight-card__metric {
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--color-denim-deep);
    white-space: nowrap;
  }

  .highlight-card--cream .highlight-card__metric {
    color: #74b4f0;
  }

  .highlight-card--blue .highlight-card__metric {
    color: var(--color-navy);
  }

  .highlight-card__tag {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--soil);
  }

  .highlight-card--cream .highlight-card__tag {
    color: rgba(230, 241, 250, 0.76);
  }

  .highlight-card--blue .highlight-card__tag {
    color: rgba(18, 35, 54, 0.78);
    font-weight: 600;
  }

  .highlight-card__heading {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
    padding-top: 0.25rem;
  }

  .highlight-card--cream .highlight-card__heading {
    color: var(--color-white);
  }

  .highlight-card--blue .highlight-card__heading {
    color: var(--color-navy);
  }

  .highlight-card__detail {
    font-size: 0.94rem;
    color: var(--ink);
    opacity: 0.88;
    line-height: 1.55;
  }

  .highlight-card--cream .highlight-card__detail {
    color: rgba(230, 241, 250, 0.88);
    opacity: 1;
  }

  .highlight-card--blue .highlight-card__detail {
    color: var(--color-navy);
    opacity: 0.92;
  }

  @media (max-width: 600px) {
    .highlights__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
