---
const items = [
  {
    label: 'Primary Focus',
    value: 'Business Strategy, Consulting, Marketing',
  },
  {
    label: 'Education',
    value: 'International Business Management · BINUS University',
  },
];
---

<section class="info-strip surface-dark" aria-label="Executive metadata">
  <div class="container">
    <dl class="info-strip__grid">
      {
        items.map((item) => (
          <div class="info-strip__cell" data-reveal="up">
            <dt class="info-strip__label">{item.label}</dt>
            <dd class="info-strip__value">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .info-strip {
    background-color: var(--bg-dark);
    color: var(--ink-light);
    border-top: 1px solid var(--border-hairline-dark);
    border-bottom: 1px solid var(--border-hairline-dark);
  }

  .info-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .info-strip__cell {
    padding: var(--space-md) var(--space-sm);
    border-right: 1px solid var(--border-hairline-dark);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .info-strip__cell:first-child {
    padding-left: 0;
  }

  .info-strip__cell:last-child {
    border-right: none;
    padding-right: 0;
  }

  .info-strip__label {
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--blue);
  }

  .info-strip__value {
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-light);
  }

  @media (max-width: 600px) {
    .info-strip__grid {
      grid-template-columns: 1fr;
    }

    .info-strip__cell,
    .info-strip__cell:first-child {
      padding-inline: 0;
      padding-block: var(--space-sm);
      border-right: none;
      border-bottom: 1px solid var(--border-hairline-dark);
    }

    .info-strip__cell:last-child {
      border-bottom: none;
    }
  }
</style>
