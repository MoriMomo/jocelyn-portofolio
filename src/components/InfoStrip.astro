---
const items = [
  {
    label: 'Primary Focus',
    value: 'Business Strategy, Consulting, Marketing',
  },
  {
    label: 'Education',
    value: 'International Business Management · BINUS University',
  },
];
---

<section class="info-strip surface-dark" aria-label="Executive metadata">
  <div class="container">
    <dl class="info-strip__grid">
      {
        items.map((item) => (
          <div class="info-strip__cell" data-reveal="up">
            <dt class="info-strip__label">{item.label}</dt>
            <dd class="info-strip__value">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .info-strip {
    background-color: var(--color-frost);
    color: var(--color-frost);
    padding-block: var(--space-sm);
  }

  .info-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    background-color: var(--color-navy);
    border: 1px solid rgba(87, 152, 215, 0.35);
    border-radius: var(--radius-md);
    padding-inline: var(--space-lg);
    box-shadow: 0 14px 32px rgba(18, 35, 54, 0.12);
  }

  .info-strip__cell {
    padding: var(--space-md) var(--space-sm);
    border-right: 1px solid rgba(230, 241, 250, 0.18);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .info-strip__cell:first-child {
    padding-left: 0;
  }

  .info-strip__cell:last-child {
    border-right: none;
    padding-right: 0;
  }

  .info-strip__label {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-pistachio);
  }

  .info-strip__value {
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-frost);
  }

  @media (max-width: 600px) {
    .info-strip__grid {
      grid-template-columns: 1fr;
      padding-inline: var(--space-md);
    }

    .info-strip__cell,
    .info-strip__cell:first-child {
      padding-inline: 0;
      padding-block: var(--space-sm);
      border-right: none;
      border-bottom: 1px solid rgba(230, 241, 250, 0.18);
    }

    .info-strip__cell:last-child {
      border-bottom: none;
    }
  }
</style>
