---
const initialClock = `JKT ${new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Asia/Jakarta',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date())}`;

const items = [
  {
    label: 'Primary Focus',
    value: 'Business Strategy, B2B Consulting & Gen Z Marketing',
    isClock: false,
  },
  {
    label: 'Education',
    value: 'International Business Management · BINUS University',
    isClock: false,
  },
  {
    label: 'Local Time',
    value: initialClock,
    isClock: true,
  },
  {
    label: 'Availability',
    value: 'Open to Internships & Strategy Projects (2026)',
    isClock: false,
  },
  {
    label: 'Leadership Scope',
    value: '120+ Students Led · 2 Organizations Founded',
    isClock: false,
  },
];
---

<section class="info-strip surface-dark" aria-label="Executive metadata">
  <div class="container">
    <dl class="info-strip__grid">
      {
        items.map((item) => (
          <div class="info-strip__cell" data-reveal="up">
            <dt class="info-strip__label">{item.label}</dt>
            <dd
              class:list={['info-strip__value', { tabular: item.isClock }]}
              data-jkt-clock={item.isClock ? '' : undefined}
            >
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  let clockTimer: number | null = null;

  function formatJakartaTime(): string {
    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Jakarta',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    return `JKT ${formatter.format(new Date())}`;
  }

  function updateClock(): void {
    const target = document.querySelector<HTMLElement>('[data-jkt-clock]');
    if (target) target.textContent = formatJakartaTime();
  }

  function stopClock(): void {
    if (clockTimer !== null) {
      window.clearInterval(clockTimer);
      clockTimer = null;
    }
  }

  function startClock(): void {
    stopClock();
    updateClock();
    clockTimer = window.setInterval(updateClock, 15_000);
  }

  document.addEventListener('astro:page-load', startClock);
  document.addEventListener('astro:before-swap', stopClock);
</script>

<style>
  .info-strip {
    background-color: var(--bg-dark);
    color: var(--ink-light);
    border-top: 1px solid var(--border-hairline-dark);
    border-bottom: 1px solid var(--border-hairline-dark);
  }

  .info-strip__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .info-strip__cell {
    padding: var(--space-md) var(--space-sm);
    border-right: 1px solid var(--border-hairline-dark);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .info-strip__cell:first-child {
    padding-left: 0;
  }

  .info-strip__cell:last-child {
    border-right: none;
    padding-right: 0;
  }

  .info-strip__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .info-strip__value {
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-light);
  }

  @media (max-width: 1024px) {
    .info-strip__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .info-strip__cell {
      padding: var(--space-sm);
      border-bottom: 1px solid var(--border-hairline-dark);
    }

    .info-strip__cell:first-child {
      padding-left: var(--space-sm);
    }
  }

  @media (max-width: 600px) {
    .info-strip__grid {
      grid-template-columns: 1fr;
    }

    .info-strip__cell,
    .info-strip__cell:first-child {
      padding-inline: 0;
      border-right: none;
    }

    .info-strip__cell:last-child {
      border-bottom: none;
    }
  }
</style>
