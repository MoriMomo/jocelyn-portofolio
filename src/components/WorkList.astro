---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
const strategyCount = sorted.filter((e) => e.data.category === 'Strategy & Consulting').length;
const leadershipCount = sorted.filter((e) => e.data.category === 'Leadership & Community').length;
---

<section id="work" class="work-section hairline-top" aria-labelledby="work-heading">
  <span id="leadership" class="sr-only" aria-hidden="true"></span>
  <div class="container">
    <div class="work-section__header" data-reveal="up">
      <div>
        <p class="eyebrow">Portfolio Index · 01 — {String(sorted.length).padStart(2, '0')}</p>
        <h2 id="work-heading" class="serif-heading work-section__title">
          Selected Case Studies & Leadership
        </h2>
      </div>

      <div class="work-filter" role="tablist" aria-label="Filter projects by category">
        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="work-filter__btn is-active"
          data-filter="all"
        >
          All <span class="tabular">({sorted.length})</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="work-filter__btn"
          data-filter="Strategy & Consulting"
        >
          Strategy & Consulting <span class="tabular">({strategyCount})</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="work-filter__btn"
          data-filter="Leadership & Community"
        >
          Leadership & Community <span class="tabular">({leadershipCount})</span>
        </button>
      </div>
    </div>

    <div class="work-table__head hairline-top hairline-bottom" aria-hidden="true">
      <span>#</span>
      <span>Case Study / Initiative</span>
      <span>Role & Organization</span>
      <span>Outcome</span>
      <span>View</span>
    </div>

    <div class="work-list" data-work-list>
      {
        sorted.map((entry, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <a
              href={`/work/${entry.id}`}
              class="work-row hairline-bottom"
              data-work-row
              data-category={entry.data.category}
              data-preview-index={idx}
              data-reveal="up"
            >
              <span class="tabular work-row__index">{num}</span>

              <div class="work-row__main">
                <div class="work-row__thumb">
                  <Image
                    src={entry.data.cover}
                    alt={entry.data.coverAlt}
                    width={560}
                    height={340}
                    class="work-row__thumb-img"
                  />
                </div>
                <div class="work-row__title-group">
                  <h3 class="serif-heading work-row__title">{entry.data.title}</h3>
                  <p class="work-row__summary">{entry.data.summary}</p>
                </div>
              </div>

              <div class="work-row__meta">
                <span class="work-row__role">{entry.data.role}</span>
                <span class="work-row__org">{entry.data.org}</span>
              </div>

              <div class="work-row__outcome">
                <span
                  class:list={[
                    'badge',
                    entry.data.category === 'Strategy & Consulting' ? 'badge--cream' : 'badge--blue',
                  ]}
                >
                  {entry.data.tag}
                </span>
              </div>

              <span class="work-row__arrow" aria-hidden="true">
                Case Study ↗
              </span>
            </a>
          );
        })
      }
    </div>

    <!-- Desktop cursor-following floating preview -->
    <div class="work-preview" aria-hidden="true" data-work-preview>
      {
        sorted.map((entry, idx) => (
          <div class="work-preview__item" data-preview-card={idx}>
            <Image
              src={entry.data.cover}
              alt=""
              width={520}
              height={320}
              class="work-preview__img"
            />
            <div class="work-preview__caption">
              <span class="tabular">0{idx + 1}</span>
              <span>{entry.data.tag}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupWorkList() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const rows = document.querySelectorAll<HTMLElement>('[data-work-row]');
    const previewContainer = document.querySelector<HTMLElement>('[data-work-preview]');
    const previewCards = document.querySelectorAll<HTMLElement>('[data-preview-card]');

    const applyFilter = (category: string) => {
      buttons.forEach((btn) => {
        const active = btn.dataset.filter === category;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', String(active));
      });

      rows.forEach((row) => {
        const match = category === 'all' || row.dataset.category === category;
        row.hidden = !match;
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyFilter(btn.dataset.filter || 'all');
      });
    });

    // If navigated via #leadership anchor, filter to Leadership & Community
    const checkHash = () => {
      if (window.location.hash === '#leadership') {
        applyFilter('Leadership & Community');
        document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
      }
    };
    window.addEventListener('hashchange', checkHash);
    checkHash();

    // Floating hover preview for fine pointer devices when reduced-motion is off
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!canHover || reducedMotion || !previewContainer) return;

    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => {
        const idx = row.dataset.previewIndex;
        previewContainer.classList.add('is-visible');
        previewCards.forEach((card) => {
          card.classList.toggle('is-active', card.dataset.previewCard === idx);
        });
      });

      row.addEventListener('mouseleave', () => {
        previewContainer.classList.remove('is-visible');
      });

      row.addEventListener('mousemove', (e: MouseEvent) => {
        const x = Math.min(window.innerWidth - 360, e.clientX + 28);
        const y = Math.min(window.innerHeight - 250, Math.max(80, e.clientY - 110));
        previewContainer.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      });
    });
  }

  document.addEventListener('astro:page-load', setupWorkList);
</script>

<style>
  .work-section {
    padding-block: var(--space-2xl);
    position: relative;
  }

  .work-section__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .work-section__title {
    font-size: var(--step-3);
    margin-top: 0.3rem;
  }

  .work-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .work-filter__btn {
    padding: 0.5rem 0.95rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    background-color: transparent;
    color: var(--soil);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-fast) ease;
  }

  .work-filter__btn:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .work-filter__btn.is-active {
    background-color: var(--ink);
    color: var(--cream);
    border-color: var(--ink);
  }

  .work-table__head {
    display: grid;
    grid-template-columns: 3.2rem 1.8fr 1.1fr 0.95fr 6.5rem;
    gap: var(--space-md);
    padding-block: 0.75rem;
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--soil);
  }

  .work-row {
    display: grid;
    grid-template-columns: 3.2rem 1.8fr 1.1fr 0.95fr 6.5rem;
    gap: var(--space-md);
    align-items: center;
    padding-block: var(--space-md);
    transition: background-color var(--duration-fast) ease, padding-inline var(--duration-base) var(--ease-out-expo);
  }

  .work-row[hidden] {
    display: none;
  }

  .work-row:hover {
    background-color: var(--surface-elevated);
    padding-inline: var(--space-xs);
  }

  .work-row__index {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--red);
  }

  .work-row__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .work-row__thumb {
    display: none;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-hairline);
    aspect-ratio: 16 / 10;
    background-color: var(--cream);
  }

  .work-row__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-row__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .work-row:hover .work-row__title {
    color: var(--red);
  }

  .work-row__summary {
    font-size: 0.93rem;
    color: var(--soil);
    margin-top: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-row__meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .work-row__role {
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--ink);
  }

  .work-row__org {
    font-size: 0.84rem;
    color: var(--soil);
  }

  .work-row__outcome {
    display: flex;
    align-items: center;
  }

  .work-row__arrow {
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--red);
    text-align: right;
    white-space: nowrap;
  }

  /* Floating cursor preview on desktop */
  .work-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    pointer-events: none;
    z-index: 40;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .work-preview.is-visible {
    opacity: 1;
  }

  .work-preview__item {
    display: none;
    background-color: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 0.5rem;
    box-shadow: 0 20px 45px rgba(35, 24, 21, 0.18);
  }

  .work-preview__item.is-active {
    display: block;
  }

  .work-preview__img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background-color: var(--cream);
  }

  .work-preview__caption {
    display: flex;
    justify-content: space-between;
    padding-top: 0.45rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--soil);
  }

  @media (hover: none), (pointer: coarse), (max-width: 980px) {
    .work-preview {
      display: none !important;
    }

    .work-table__head {
      display: none;
    }

    .work-row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
      padding-block: var(--space-md);
    }

    .work-row__thumb {
      display: block;
      margin-bottom: 0.35rem;
    }

    .work-row__arrow {
      text-align: left;
      padding-top: 0.25rem;
    }
  }
</style>
