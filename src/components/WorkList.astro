---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { entries } = Astro.props;
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
const strategyCount = sorted.filter((e) => e.data.category === 'Strategy & Consulting').length;
const leadershipCount = sorted.filter((e) => e.data.category === 'Leadership & Community').length;
const totalPad = String(sorted.length).padStart(2, '0');
---

<section id="work" class="work-section surface-light hairline-top" aria-labelledby="work-heading">
  <span id="leadership" class="sr-only" aria-hidden="true"></span>
  <div class="container">
    <div class="work-section__header" data-reveal="up">
      <div>
        <div class="work-section__eyebrow-row">
          <p class="eyebrow">Selected Work</p>
          <span class="tabular work-section__counter" data-work-counter data-total={totalPad}>
            01/{totalPad}
          </span>
        </div>
        <h2 id="work-heading" class="serif-heading work-section__title" data-reveal="lines">
          Case Studies & Leadership
        </h2>
      </div>

      <div class="work-filter" role="tablist" aria-label="Filter projects by category">
        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="work-filter__btn is-active"
          data-filter="all"
        >
          All <span class="tabular">({sorted.length})</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="work-filter__btn"
          data-filter="Strategy & Consulting"
        >
          Strategy & Consulting <span class="tabular">({strategyCount})</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="work-filter__btn"
          data-filter="Leadership & Community"
        >
          Leadership & Community <span class="tabular">({leadershipCount})</span>
        </button>
      </div>
    </div>

    <div class="work-table__head hairline-top hairline-bottom" aria-hidden="true">
      <span>#</span>
      <span>Case Study / Initiative</span>
      <span>Role & Organization</span>
      <span>Outcome</span>
      <span>View</span>
    </div>

    <div class="work-list" data-work-list>
      {
        sorted.map((entry, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <a
              href={`${base}/work/${entry.id}`}
              class="work-row hairline-bottom"
              data-work-row
              data-category={entry.data.category}
              data-preview-index={idx}
              data-row-num={num}
              data-cursor-target
              data-reveal="up"
            >
              <span class="tabular work-row__index">{num}</span>

              <div class="work-row__main">
                <div class="work-row__thumb">
                  <Image
                    src={entry.data.cover}
                    alt={entry.data.coverAlt}
                    width={560}
                    height={340}
                    loading={idx < 3 ? 'eager' : 'lazy'}
                    class="work-row__thumb-img"
                  />
                </div>
                <div class="work-row__title-group">
                  <h3 class="serif-heading work-row__title">{entry.data.title}</h3>
                  <p class="work-row__summary">{entry.data.summary}</p>
                </div>
              </div>

              <div class="work-row__meta">
                <span class="work-row__role">{entry.data.role}</span>
                <span class="work-row__org">{entry.data.org}</span>
              </div>

              <div class="work-row__outcome">
                <span
                  class:list={[
                    'badge',
                    entry.data.category === 'Strategy & Consulting' ? 'badge--cream' : 'badge--blue',
                  ]}
                >
                  {entry.data.result}
                </span>
              </div>

              <span class="work-row__arrow roll-link" aria-hidden="true">
                <span class="roll-text" data-text="Case Study ↗">Case Study ↗</span>
              </span>
            </a>
          );
        })
      }
    </div>

    <!-- Desktop cursor-following floating preview card -->
    <div class="work-preview" aria-hidden="true" data-work-preview>
      {
        sorted.map((entry, idx) => (
          <div class="work-preview__item" data-preview-card={idx}>
            <Image
              src={entry.data.cover}
              alt=""
              width={520}
              height={320}
              class="work-preview__img"
            />
            <div class="work-preview__caption">
              <span class="tabular">{String(idx + 1).padStart(2, '0')}/{totalPad}</span>
              <span>{entry.data.tag}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Magnetic GSAP cursor pill -->
    <div class="cursor-pill" data-cursor-pill aria-hidden="true">
      View work ↗
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  let workController: AbortController | null = null;

  function setCounterText(counter: HTMLElement | null, current: string, total: string): void {
    if (counter) counter.textContent = `${current}/${total}`;
  }

  function animateFilterChange(visibleRows: HTMLElement[], counter: HTMLElement | null): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ScrollTrigger.refresh();
      return;
    }

    gsap.killTweensOf(visibleRows);
    if (visibleRows.length > 0) {
      gsap.fromTo(
        visibleRows,
        { opacity: 0, y: 16 },
        {
          opacity: 1,
          y: 0,
          duration: 0.45,
          stagger: 0.045,
          ease: 'power3.out',
          clearProps: 'transform,opacity',
          onComplete: () => ScrollTrigger.refresh(),
        },
      );
    }

    if (counter) {
      gsap.killTweensOf(counter);
      gsap.fromTo(
        counter,
        { opacity: 0.35, y: 4 },
        { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out', clearProps: 'transform,opacity' },
      );
    }
  }

  function applyCategoryFilter(
    category: string,
    buttons: NodeListOf<HTMLButtonElement>,
    rows: NodeListOf<HTMLElement>,
    counter: HTMLElement | null,
  ): void {
    const visibleRows: HTMLElement[] = [];
    buttons.forEach((btn) => {
      const active = btn.dataset.filter === category;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-selected', String(active));
    });

    rows.forEach((row) => {
      const match = category === 'all' || row.dataset.category === category;
      row.hidden = !match;
      if (match) visibleRows.push(row);
    });

    const total = String(visibleRows.length).padStart(2, '0');
    if (counter) counter.dataset.total = total;
    setCounterText(counter, visibleRows.length > 0 ? '01' : '00', total);
    animateFilterChange(visibleRows, counter);
  }

  function activatePreviewCard(
    container: HTMLElement,
    cards: NodeListOf<HTMLElement>,
    index: string | undefined,
  ): void {
    container.classList.add('is-visible');
    cards.forEach((card) => card.classList.toggle('is-active', card.dataset.previewCard === index));
  }

  function positionPreviewCard(container: HTMLElement, e: MouseEvent): void {
    const x = Math.min(window.innerWidth - 350, e.clientX + 44);
    const y = Math.min(window.innerHeight - 250, Math.max(80, e.clientY - 115));
    container.style.transform = `translate3d(${x}px, ${y}px, 0)`;
  }

  function getCounterTotal(counter: HTMLElement | null): string {
    if (!counter) return '10';
    return counter.dataset.total || '10';
  }

  function handleRowEnter(
    row: HTMLElement,
    counter: HTMLElement | null,
    previewContainer: HTMLElement | null,
    previewCards: NodeListOf<HTMLElement>,
    allowPreview: boolean,
  ): void {
    setCounterText(counter, row.dataset.rowNum || '01', getCounterTotal(counter));
    if (!allowPreview || !previewContainer) return;
    activatePreviewCard(previewContainer, previewCards, row.dataset.previewIndex);
  }

  function bindRowHover(
    rows: NodeListOf<HTMLElement>,
    counter: HTMLElement | null,
    previewContainer: HTMLElement | null,
    previewCards: NodeListOf<HTMLElement>,
    signal: AbortSignal,
  ): void {
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const allowPreview = Boolean(canHover && !reduced && previewContainer);

    rows.forEach((row) => {
      row.addEventListener(
        'mouseenter',
        () => handleRowEnter(row, counter, previewContainer, previewCards, allowPreview),
        { signal },
      );

      if (!allowPreview || !previewContainer) return;

      row.addEventListener(
        'mouseleave',
        () => previewContainer.classList.remove('is-visible'),
        { signal },
      );
      row.addEventListener(
        'mousemove',
        (e: MouseEvent) => positionPreviewCard(previewContainer, e),
        { signal },
      );
    });
  }

  function setupWorkList(): void {
    workController?.abort();
    workController = new AbortController();
    const { signal } = workController;

    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const rows = document.querySelectorAll<HTMLElement>('[data-work-row]');
    const counter = document.querySelector<HTMLElement>('[data-work-counter]');
    const previewContainer = document.querySelector<HTMLElement>('[data-work-preview]');
    const previewCards = document.querySelectorAll<HTMLElement>('[data-preview-card]');

    buttons.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => applyCategoryFilter(btn.dataset.filter || 'all', buttons, rows, counter),
        { signal },
      );
    });

    const checkHash = () => {
      if (window.location.hash !== '#leadership') return;
      applyCategoryFilter('Leadership & Community', buttons, rows, counter);
      document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
    };
    window.addEventListener('hashchange', checkHash, { signal });
    checkHash();

    bindRowHover(rows, counter, previewContainer, previewCards, signal);
  }

  document.addEventListener('astro:page-load', setupWorkList);
  document.addEventListener('astro:before-swap', () => workController?.abort());
</script>

<style>
  .work-section {
    padding-block: var(--space-2xl);
    position: relative;
  }

  .work-section__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .work-section__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .work-section__counter {
    color: var(--soil);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .work-section__title {
    font-size: var(--step-3);
    margin-top: 0.35rem;
  }

  .work-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .work-filter__btn {
    padding: 0.5rem 0.95rem;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    background-color: transparent;
    color: var(--soil);
    border: 1px solid rgba(18, 35, 54, 0.16);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .work-filter__btn:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .work-filter__btn.is-active {
    background-color: var(--color-pistachio);
    color: var(--color-navy);
    border-color: var(--color-pistachio);
  }

  .work-table__head {
    display: grid;
    grid-template-columns: 3.2rem 1.8fr 1.1fr 0.95fr 7rem;
    gap: var(--space-md);
    padding-block: 0.75rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--soil);
  }

  .work-row {
    display: grid;
    grid-template-columns: 3.2rem 1.8fr 1.1fr 0.95fr 7rem;
    gap: var(--space-md);
    align-items: center;
    padding-block: var(--space-md);
    transition: background-color var(--duration-fast) ease, padding-inline var(--duration-base) var(--ease-out-expo);
  }

  .work-row[hidden] {
    display: none;
  }

  .work-row:hover {
    background-color: rgba(255, 255, 255, 0.65);
    padding-inline: var(--space-xs);
  }

  .work-row__index {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--red);
  }

  .work-row__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .work-row__thumb {
    display: none;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    aspect-ratio: 16 / 10;
    background-color: var(--bg-dark);
  }

  .work-row__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-row__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .work-row:hover .work-row__title {
    color: var(--red);
  }

  .work-row__summary {
    font-size: 0.93rem;
    color: var(--soil);
    margin-top: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-row__meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .work-row__role {
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--ink);
  }

  .work-row__org {
    font-size: 0.84rem;
    color: var(--soil);
  }

  .work-row__outcome {
    display: flex;
    align-items: center;
  }

  .work-row__arrow {
    justify-self: end;
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--red);
    white-space: nowrap;
  }

  /* Magnetic GSAP cursor pill */
  .cursor-pill {
    position: fixed;
    top: 0;
    left: 0;
    padding: 0.55rem 1rem;
    background-color: var(--color-pistachio);
    color: var(--color-navy);
    border: 1px solid var(--color-navy);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.28s var(--ease-out-expo);
    z-index: 50;
  }

  .cursor-pill.is-active {
    transform: translate(-50%, -50%) scale(1);
  }

  /* Floating cursor preview card on desktop */
  .work-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 310px;
    pointer-events: none;
    z-index: 40;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .work-preview.is-visible {
    opacity: 1;
  }

  .work-preview__item {
    display: none;
    background-color: var(--color-frost-elevated);
    color: var(--color-navy);
    border: 1px solid rgba(18, 35, 54, 0.16);
    border-radius: var(--radius-md);
    padding: 0.45rem;
    box-shadow: 0 22px 48px rgba(18, 35, 54, 0.14);
  }

  .work-preview__item.is-active {
    display: block;
  }

  .work-preview__img {
    width: 100%;
    height: 185px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background-color: var(--color-frost);
  }

  .work-preview__caption {
    display: flex;
    justify-content: space-between;
    padding-top: 0.45rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--blue);
  }

  @media (hover: none), (pointer: coarse), (max-width: 980px) {
    .work-preview,
    .cursor-pill {
      display: none !important;
    }

    .work-table__head {
      display: none;
    }

    .work-row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
      padding-block: var(--space-md);
    }

    .work-row__thumb {
      display: block;
      margin-bottom: 0.35rem;
    }

    .work-row__arrow {
      justify-self: start;
      padding-top: 0.25rem;
    }
  }
</style>
