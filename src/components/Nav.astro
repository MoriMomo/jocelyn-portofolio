---
const navLinks = [
  { href: '/#work', label: 'Selected Work' },
  { href: '/#leadership', label: 'Leadership' },
  { href: '/#credentials', label: 'Credentials' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header hairline-bottom">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Jocelyn Lau — Home">
      <span class="site-header__monogram">JL</span>
      <span class="site-header__name">Jocelyn Lau</span>
      <span class="site-header__role">Portfolio</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          navLinks.map((item) => (
            <li>
              <a href={item.href} class="site-nav__link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="mailto:Jocelynlau007@gmail.com" class="btn btn--primary site-nav__cta">
        Get in Touch
      </a>
    </nav>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="menu-toggle__label" data-menu-label>Menu</span>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        aria-hidden="true"
      >
        <line x1="3" y1="8" x2="21" y2="8"></line>
        <line x1="3" y1="16" x2="21" y2="16"></line>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    hidden
    data-mobile-menu
  >
    <div class="container mobile-menu__inner">
      <p class="eyebrow">Navigation</p>
      <ul class="mobile-menu__list">
        {
          navLinks.map((item, idx) => (
            <li>
              <a href={item.href} class="mobile-menu__link" data-mobile-link>
                <span class="tabular mobile-menu__idx">0{idx + 1}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__footer">
        <a href="mailto:Jocelynlau007@gmail.com" class="btn btn--primary" data-mobile-link>
          Email Jocelyn
        </a>
        <a
          href="https://www.linkedin.com/in/jocelyn-lau-4546b128b/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--outline"
          data-mobile-link
        >
          LinkedIn ↗
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { setupMobileMenu, cleanupMobileMenu } from '../scripts/mobileMenu';

  document.addEventListener('astro:page-load', setupMobileMenu);
  document.addEventListener('astro:before-swap', cleanupMobileMenu);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(252, 251, 244, 0.92);
    backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: var(--space-md);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .site-header__monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background-color: var(--ink);
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
  }

  .site-header__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .site-header__role {
    font-size: var(--step--1);
    color: var(--soil);
    padding-left: 0.65rem;
    border-left: 1px solid var(--border-hairline);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
  }

  .site-nav__link {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--soil);
    padding-block: 0.35rem;
    position: relative;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--red);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .site-nav__link:hover {
    color: var(--ink);
  }

  .site-nav__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav__cta {
    padding: 0.55rem 1rem;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.8rem;
    background-color: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mobile-menu {
    background-color: var(--surface);
    border-bottom: 1px solid var(--border-strong);
    padding-block: var(--space-lg);
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .mobile-menu__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-hairline);
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--border-hairline);
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--ink);
  }

  .mobile-menu__idx {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--red);
    font-weight: 600;
  }

  .mobile-menu__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-xs);
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }

    .site-header__role {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }
</style>
