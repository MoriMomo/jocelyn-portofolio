---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;

const navLinks = [
  { href: `${base}/#work`, label: 'Selected Work' },
  { href: `${base}/#highlights`, label: 'Highlights' },
  { href: `${base}/#credentials`, label: 'Credentials' },
  { href: `${base}/#contact`, label: 'Contact' },
];

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === homeHref;
---

<header class={`site-header surface-dark ${isHome ? 'site-header--home' : 'site-header--sub'}`}>
  <div class="container site-header__bar">
    <a href={homeHref} class="site-header__brand roll-link" aria-label="Jocelyn Lau — Home">
      <span class="roll-text" data-text="JOCELYNLAU.WORK">JOCELYNLAU.WORK</span>
    </a>

    <nav class="site-header__quick" aria-label="Quick navigation">
      <a href={`${base}/#work`} class="site-header__quick-link roll-link">
        <span class="roll-text" data-text="WORK">WORK</span>
      </a>
      <a href={`${base}/#credentials`} class="site-header__quick-link roll-link">
        <span class="roll-text" data-text="ABOUT">ABOUT</span>
      </a>
      <a href={`${base}/#contact`} class="site-header__quick-link roll-link">
        <span class="roll-text" data-text="CONTACT">CONTACT</span>
      </a>
    </nav>

    <div class="site-header__year" aria-label="Portfolio 2026">
      <span class="site-header__year-label">PORTFOLIO</span>
      <span class="site-header__year-num">2026</span>
    </div>
  </div>

  <div class="site-dock" aria-label="Corner controls">
    <a href={homeHref} class="dock-monogram" aria-label="Jocelyn Lau — Back to top">
      <span>JL</span>
    </a>

    <button
      type="button"
      class="dock-menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <svg
        class="dock-menu__dots"
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="currentColor"
        aria-hidden="true"
      >
        <rect x="0" y="5" width="3" height="3" rx="0.5"></rect>
        <rect x="5.5" y="0" width="3" height="3" rx="0.5"></rect>
        <rect x="5.5" y="11" width="3" height="3" rx="0.5"></rect>
        <rect x="11" y="5" width="3" height="3" rx="0.5"></rect>
      </svg>
      <span class="dock-menu__label" data-menu-label>Menu</span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu surface-dark"
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    hidden
    data-mobile-menu
  >
    <div class="container mobile-menu__inner">
      <div class="mobile-menu__top">
        <p class="mobile-menu__eyebrow">Navigation · 2026 Edition</p>
        <p class="mobile-menu__location">Jakarta, Indonesia · BINUS International</p>
      </div>

      <ul class="mobile-menu__list">
        {
          navLinks.map((item, idx) => (
            <li>
              <a href={item.href} class="mobile-menu__link" data-mobile-link>
                <span class="tabular mobile-menu__idx">0{idx + 1}</span>
                <span class="roll-link">
                  <span class="roll-text" data-text={item.label}>{item.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mobile-menu__footer">
        <a href="mailto:Jocelynlau007@gmail.com" class="btn btn--red-on-dark" data-mobile-link>
          Email Jocelyn
        </a>
        <a
          href="https://www.linkedin.com/in/jocelyn-lau-4546b128b/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--outline-on-dark"
          data-mobile-link
        >
          LinkedIn ↗
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { setupMobileMenu, cleanupMobileMenu } from '../scripts/mobileMenu';

  document.addEventListener('astro:page-load', setupMobileMenu);
  document.addEventListener('astro:before-swap', cleanupMobileMenu);
</script>

<style>
  .site-header {
    background-color: var(--bg-dark);
    color: var(--ink-light);
    position: relative;
    z-index: 60;
  }

  .site-header--sub {
    border-bottom: 1px solid var(--border-hairline-dark);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4rem;
    gap: var(--space-md);
  }

  .site-header__brand {
    justify-self: start;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-light);
  }

  .site-header__quick {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: var(--space-md);
  }

  .site-header__quick-link {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--blue);
  }

  .site-header__quick-link:hover {
    color: var(--ink-light);
  }

  .site-header__year {
    justify-self: end;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink-light);
  }

  .site-header__year-label {
    font-weight: 500;
  }

  .site-header__year-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--blue);
  }

  .site-dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: clamp(1rem, 2.5vh, 1.5rem);
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    z-index: 65;
  }

  .dock-monogram,
  .dock-menu {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(244, 249, 253, 0.92);
    backdrop-filter: blur(10px);
    color: var(--color-navy);
    border: 1px solid rgba(18, 35, 54, 0.16);
    border-radius: var(--radius-md);
    box-shadow: 0 10px 28px rgba(18, 35, 54, 0.1);
    transition: border-color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .dock-monogram {
    width: 2.75rem;
    height: 2.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .dock-menu {
    gap: 0.55rem;
    height: 2.75rem;
    padding-inline: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .dock-menu__dots {
    color: var(--color-denim);
    flex-shrink: 0;
  }

  .dock-monogram:hover,
  .dock-menu:hover {
    border-color: var(--color-denim);
    background-color: var(--color-pistachio);
    color: var(--color-navy);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: var(--bg-dark);
    color: var(--ink-light);
    display: flex;
    align-items: center;
    padding-block: var(--space-xl);
    overflow-y: auto;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .mobile-menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .mobile-menu__eyebrow,
  .mobile-menu__location {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .mobile-menu__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-hairline-dark);
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: clamp(0.85rem, 2vh, 1.35rem);
    border-bottom: 1px solid var(--border-hairline-dark);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.08;
    color: var(--ink-light);
  }

  .mobile-menu__link:hover {
    color: var(--blue);
  }

  .mobile-menu__idx {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--blue);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .mobile-menu__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-xs);
  }

  .btn--red-on-dark {
    background-color: var(--color-navy);
    color: var(--color-frost);
    border-color: var(--color-navy);
  }

  .btn--red-on-dark:hover {
    background-color: var(--color-denim-deep);
    color: var(--color-white);
    border-color: var(--color-denim-deep);
  }

  .btn--outline-on-dark {
    background-color: transparent;
    color: var(--color-navy);
    border-color: var(--border-strong-dark);
  }

  .btn--outline-on-dark:hover {
    background-color: var(--color-pistachio);
    color: var(--color-navy);
    border-color: var(--color-pistachio);
  }

  @media (max-width: 860px) {
    .site-header__bar {
      grid-template-columns: 1fr auto;
    }

    .site-header__quick {
      display: none;
    }
  }
</style>
