---
import type { DitherProps } from '../scripts/dither/types';

type Props = DitherProps;

const {
  waveSpeed = 0.05,
  waveFrequency = 3,
  waveAmplitude = 0.3,
  waveColor = [0.5, 0.5, 0.5],
  backgroundColor = [0, 0, 0],
  colorNum = 4,
  pixelSize = 2,
  disableAnimation = false,
  enableMouseInteraction = true,
  mouseRadius = 1,
  ditherMode = 'bayer',
  palette,
  scale = 1,
  contrast = 1,
  brightness = 0,
  mouseEffect = 'erase',
  mouseStrength = 1,
  trail = 0.5,
  clickRipple = true,
  intro = true,
  dpr,
  className = '',
} = Astro.props;

const options: DitherProps = {
  waveSpeed,
  waveFrequency,
  waveAmplitude,
  waveColor,
  backgroundColor,
  colorNum,
  pixelSize,
  disableAnimation,
  enableMouseInteraction,
  mouseRadius,
  ditherMode,
  palette,
  scale,
  contrast,
  brightness,
  mouseEffect,
  mouseStrength,
  trail,
  clickRipple,
  intro,
  dpr,
};
---

<div
  class:list={['dither-container', className]}
  data-dither={JSON.stringify(options)}
  aria-hidden="true"
>
  <canvas class="dither-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { mountDither } from '../scripts/dither/mount';

  let cleanups: Array<() => void> = [];

  function initAllDither(): void {
    cleanups.forEach((fn) => fn());
    cleanups = [];
    document.querySelectorAll<HTMLElement>('[data-dither]').forEach((el) => {
      cleanups.push(mountDither(el));
    });
  }

  document.addEventListener('astro:page-load', initAllDither);
  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });
</script>

<style>
  .dither-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .dither-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
