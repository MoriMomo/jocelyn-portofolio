---
import Wordmark from './Wordmark.astro';
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__top">
      <div class="hero__meta">
        <p class="eyebrow">International Business Management · BINUS University</p>
        <span class="badge badge--blue">Open to Internships & Consulting</span>
      </div>

      <h1 class="serif-heading hero__title" data-reveal="lines">
        Building growth strategies, market-entry frameworks, and student-led initiatives that help local businesses <em>scale globally</em>.
      </h1>

      <div class="hero__sub-row" data-reveal="up">
        <p class="hero__lead">
          Jocelyn Lau is a business strategist, startup project manager, and student organization founder focused on elevating Indonesian enterprises (UMKM) to international competitiveness.
        </p>
        <div class="hero__actions">
          <a href="#work" class="btn btn--primary">Explore Case Studies ↓</a>
          <a href="#credentials" class="btn btn--outline">View Credentials</a>
        </div>
      </div>
    </div>

    <div class="hero__masthead hairline-top">
      <Wordmark variant="hero" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-md);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .hero__title {
    font-size: var(--step-4);
    max-width: 24ch;
    color: var(--ink);
  }

  .hero__title em {
    font-style: italic;
    color: var(--red);
    font-weight: 500;
  }

  .hero__sub-row {
    display: grid;
    grid-template-columns: 1.2fr auto;
    align-items: end;
    gap: var(--space-lg);
    padding-top: var(--space-xs);
  }

  .hero__lead {
    color: var(--soil);
    max-width: 58ch;
    font-size: var(--step-0);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .hero__masthead {
    padding-top: var(--space-sm);
  }

  @media (max-width: 860px) {
    .hero__sub-row {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
