---
import { getImage } from 'astro:assets';
import lanyardPortraitImg from '../assets/lanyard-portrait.jpg';
import Lanyard from './Lanyard.astro';
import PixelSnow from './PixelSnow.astro';
import Wordmark from './Wordmark.astro';

const portraitAsset = await getImage({ src: lanyardPortraitImg, width: 800, format: 'webp' });
---

<section id="top" class="hero surface-dark" aria-labelledby="hero-heading">
  <div class="hero__snow" aria-hidden="true">
    <PixelSnow
      color="#f0eae6"
      variant="snowflake"
      density={0.45}
      speed={0.55}
      wind={0.18}
      sway={0.45}
      flakeSize={1}
      pixelSize={3}
      glow={0.75}
      twinkle={0.35}
      brightness={1.1}
      fade={0.3}
      opacity={0.72}
      mouseInteraction={true}
    />
  </div>
  <div class="container hero__stage">
    <!-- Interactive 3D Lanyard Portrait Badge -->
    <div class="hero__portrait-wrap" data-reveal="up">
      <Lanyard
        frontImage={portraitAsset.src}
        alt="Jocelyn Lau, Business Strategist and International Business Management Scholar"
        cardColor="#111113"
        strapColor="#830000"
        metal="silver"
        finish="glossy"
        cornerRadius={0.22}
        size={0.58}
        strapLength={0.42}
        strapWidth={0.65}
        interactive={true}
        intro={true}
      />
    </div>

    <!-- Mid-Hero Horizontal Rule Row: HI THERE · Starburst · Hook Statement -->
    <div class="hero__mid-band">
      <div class="hero__mid-left" data-hero-meta>
        <p class="hero__hi">Based in</p>
        <p class="hero__loc">Jakarta · BINUS</p>
      </div>

      <div class="hero__star-slot" aria-hidden="true">
        <svg class="hero__star" data-hero-star width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path
            d="M12 0L13.5 9.2L22.5 5.5L15.2 11.8L24 12L15.2 12.2L22.5 18.5L13.5 14.8L12 24L10.5 14.8L1.5 18.5L8.8 12.2L0 12L8.8 11.8L1.5 5.5L10.5 9.2L12 0Z"
            fill="currentColor"
          />
        </svg>
      </div>

      <div class="hero__mid-right" data-hero-meta>
        <p class="hero__hook">
          Case-tested growth, export, and Gen Z brand strategy from BINUS University to international finals in Singapore.
        </p>
        <a href="mailto:Jocelynlau007@gmail.com" class="hero__cta roll-link">
          <span class="roll-text" data-text="Email for 2026 Internships ↗">Email for 2026 Internships ↗</span>
        </a>
      </div>
    </div>

    <!-- Broken Display Typographic Lockup Overlapping Lower Portrait -->
    <h1 id="hero-heading" class="hero__display">
      <span class="sr-only">Jocelyn Lau — Business Strategy, Consulting & Leadership Portfolio</span>
      <Wordmark variant="hero" />
      <span class="hero__strategy-row" aria-hidden="true">
        <span class="hero__strategy-meta" data-hero-meta>IBM · BINUS UNIVERSITY</span>
        <span class="hero__strategy-word">
          <span class="hero__strategy-italic">.</span>PORTFOLIO
        </span>
      </span>
    </h1>
  </div>
</section>

<style>
  .hero {
    background-color: var(--bg-dark);
    color: var(--ink-light);
    padding-top: var(--space-sm);
    padding-bottom: clamp(4.5rem, 8vh, 5.75rem);
    position: relative;
    overflow-x: clip;
  }

  .hero__snow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__stage {
    position: relative;
    z-index: 1;
    min-height: clamp(32rem, 78svh, 48rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero__portrait-wrap {
    position: absolute;
    left: clamp(4%, 11vw, 18%);
    top: -0.5rem;
    width: clamp(24rem, 46vw, 40rem);
    height: clamp(26rem, 68vh, 42rem);
    z-index: 2;
    pointer-events: auto;
    border-radius: var(--radius-md);
    background: radial-gradient(
      ellipse 56% 52% at 50% 56%,
      rgba(131, 0, 0, 0.32) 0%,
      rgba(131, 0, 0, 0.08) 54%,
      transparent 78%
    );
  }

  .hero__mid-band {
    position: relative;
    z-index: 3;
    pointer-events: none;
    margin-top: clamp(7.5rem, 18vh, 12.5rem);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--border-hairline-dark);
    display: grid;
    grid-template-columns: 1fr auto minmax(16rem, 23rem);
    align-items: start;
    gap: var(--space-md);
  }

  .hero__mid-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero__hi {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink-light);
  }

  .hero__loc {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--blue);
  }

  .hero__star-slot {
    justify-self: center;
    padding-top: 0.15rem;
  }

  .hero__star {
    color: var(--blue);
    transform-origin: center;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .hero:hover .hero__star {
    transform: rotate(45deg);
  }

  .hero__mid-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: 0.65rem;
  }

  .hero__hook {
    font-size: clamp(0.9rem, 0.84rem + 0.28vw, 1.05rem);
    line-height: 1.45;
    color: var(--ink-light);
    max-width: 30ch;
  }

  .hero__cta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    border-bottom: 1px solid rgba(255, 0, 0, 0.55);
    line-height: 1.35;
    pointer-events: auto;
  }

  .hero__cta:hover {
    color: var(--ink-light);
    border-bottom-color: var(--ink-light);
  }

  .hero__display {
    position: relative;
    z-index: 3;
    pointer-events: none;
    margin-top: clamp(2rem, 5vh, 4rem);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .hero__strategy-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .hero__strategy-meta {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--blue);
    padding-left: 0.25rem;
  }

  .hero__strategy-word {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(2.1rem, 8.8vw, 7.5rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--blue);
    margin-left: auto;
  }

  :global(.hero__rotate-word) {
    padding-bottom: 0.05em;
  }

  .hero__strategy-italic {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: var(--space-2xs);
      padding-bottom: 4.5rem;
    }

    .hero__stage {
      min-height: auto;
      gap: 0.75rem;
    }

    .hero__portrait-wrap {
      position: relative;
      left: auto;
      top: auto;
      width: min(100%, 18rem);
      height: auto;
      aspect-ratio: 1 / 1.15;
      margin-inline: auto;
    }

    .hero__mid-band {
      margin-top: 0;
      grid-template-columns: 1fr auto;
      gap: var(--space-xs);
    }

    .hero__star-slot {
      display: none;
    }

    .hero__mid-right {
      grid-column: 1 / -1;
      align-items: flex-start;
      text-align: left;
    }

    .hero__display {
      margin-top: var(--space-xs);
    }

    .hero__strategy-meta {
      display: none;
    }
  }
</style>
