---
import Wordmark from './Wordmark.astro';

const marqueeItems = [
  'JOCELYN LAU',
  'STRATEGY & LEADERSHIP',
  'INDONESIA TO GLOBAL',
  'PORTFOLIO 2026',
];
---

<footer id="contact" class="site-footer surface-dark">
  <div class="container site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__pitch" data-reveal="up">
        <p class="eyebrow site-footer__eyebrow">Inquiries & Opportunities</p>
        <h2 class="serif-heading site-footer__heading" data-reveal="lines">
          Open for 2026 strategy and consulting internships.
        </h2>
        <p class="site-footer__sub">
          Available for FMCG brand strategy, management consulting, and corporate growth internships.
        </p>
      </div>

      <div class="site-footer__actions" data-reveal="up">
        <div class="site-footer__contact-card">
          <span class="site-footer__label">Direct Email</span>
          <a href="mailto:Jocelynlau007@gmail.com" class="site-footer__value roll-link">
            <span class="roll-text" data-text="Jocelynlau007@gmail.com ↗">Jocelynlau007@gmail.com ↗</span>
          </a>
        </div>

        <div class="site-footer__contact-card">
          <span class="site-footer__label">Professional Network</span>
          <a
            href="https://www.linkedin.com/in/jocelyn-lau-4546b128b/"
            target="_blank"
            rel="noopener noreferrer"
            class="site-footer__value roll-link"
          >
            <span class="roll-text" data-text="LinkedIn / Jocelyn Lau ↗">LinkedIn / Jocelyn Lau ↗</span>
          </a>
        </div>

        <div class="site-footer__cta-row">
          <a href="mailto:Jocelynlau007@gmail.com" class="btn btn--footer-primary">
            Email Jocelyn (Jocelynlau007@gmail.com)
          </a>
          <a
            href="https://www.linkedin.com/in/jocelyn-lau-4546b128b/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--footer-outline"
          >
            Connect on LinkedIn ↗
          </a>
        </div>
      </div>
    </div>

    <div class="site-footer__wordmark">
      <Wordmark variant="footer" />
    </div>

    <div class="site-marquee" aria-label="Portfolio highlights marquee">
      <div class="site-marquee__track">
        {
          [0, 1].map((dup) => (
            <div class="site-marquee__group" aria-hidden={dup === 1 ? 'true' : undefined}>
              {marqueeItems.map((item, idx) => (
                <>
                  <span class={idx % 2 === 1 ? 'site-marquee__italic' : 'site-marquee__solid'}>
                    {item}
                  </span>
                  <span class="site-marquee__star" aria-hidden="true">✦</span>
                </>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {new Date().getFullYear()} Jocelyn Lau · International Business Management, BINUS University</p>
      <a href="#main-content" class="site-footer__backtop roll-link">
        <span class="roll-text" data-text="Back to top ↑">Back to top ↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark);
    color: var(--ink-light);
    padding-top: var(--space-2xl);
    padding-bottom: clamp(4.75rem, 8vh, 6rem);
    margin-top: var(--space-2xl);
    overflow-x: clip;
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-xl);
    align-items: start;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border-hairline-dark);
  }

  .site-footer__eyebrow {
    color: var(--blue);
    margin-bottom: var(--space-xs);
  }

  .site-footer__heading {
    color: var(--ink-light);
    font-size: var(--step-4);
    margin-bottom: var(--space-sm);
    max-width: 16ch;
  }

  .site-footer__sub {
    color: rgba(255, 255, 255, 0.84);
    max-width: 44ch;
    font-size: var(--step-0);
  }

  .site-footer__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .site-footer__contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-hairline-dark);
  }

  .site-footer__label {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--blue);
    font-weight: 600;
  }

  .site-footer__value {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink-light);
    align-self: flex-start;
  }

  .site-footer__value:hover {
    color: var(--blue);
  }

  .site-footer__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-2xs);
  }

  .btn--footer-primary {
    background-color: var(--color-white);
    color: var(--color-black);
    border-color: var(--color-white);
  }

  .btn--footer-primary:hover {
    background-color: var(--color-red);
    border-color: var(--color-red);
    color: var(--color-black);
  }

  .btn--footer-outline {
    background-color: transparent;
    color: var(--color-white);
    border-color: var(--border-strong-dark);
  }

  .btn--footer-outline:hover {
    border-color: var(--color-red);
    background-color: rgba(255, 0, 0, 0.14);
  }

  .site-footer__wordmark {
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--border-hairline-dark);
  }

  .site-marquee {
    width: 100%;
    overflow: hidden;
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--border-hairline-dark);
  }

  .site-marquee__track {
    display: flex;
    width: max-content;
    animation: marqueeScroll 28s linear infinite;
  }

  .site-marquee:hover .site-marquee__track {
    animation-play-state: paused;
  }

  .site-marquee__group {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-right: var(--space-md);
    font-size: clamp(1rem, 1.8vw, 1.5rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-marquee__solid {
    font-weight: 600;
    color: var(--cream);
  }

  .site-marquee__italic {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--blue);
  }

  .site-marquee__star {
    color: var(--blue);
    font-size: 0.9em;
  }

  @keyframes marqueeScroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-marquee__track {
      animation: none;
    }
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.72);
  }

  .site-footer__backtop {
    color: var(--cream);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-footer__backtop:hover {
    color: var(--blue);
  }

  @media (max-width: 860px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .site-footer__value {
      font-size: 1rem;
    }
  }
</style>
