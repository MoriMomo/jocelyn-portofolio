---
import Wordmark from './Wordmark.astro';
---

<footer id="contact" class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__pitch" data-reveal="up">
        <p class="eyebrow site-footer__eyebrow">Inquiries & Opportunities</p>
        <h2 class="serif-heading site-footer__heading">
          Let’s build thoughtful strategies together.
        </h2>
        <p class="site-footer__sub">
          Available for business strategy internships, consulting collaborations, and case competition partnerships.
        </p>
      </div>

      <div class="site-footer__actions" data-reveal="up">
        <div class="site-footer__contact-card">
          <span class="site-footer__label">Direct Email</span>
          <a href="mailto:Jocelynlau007@gmail.com" class="site-footer__value">
            Jocelynlau007@gmail.com ↗
          </a>
        </div>

        <div class="site-footer__contact-card">
          <span class="site-footer__label">Professional Network</span>
          <a
            href="https://www.linkedin.com/in/jocelyn-lau-4546b128b/"
            target="_blank"
            rel="noopener noreferrer"
            class="site-footer__value"
          >
            linkedin.com/in/jocelyn-lau-4546b128b ↗
          </a>
        </div>

        <div class="site-footer__cta-row">
          <a href="mailto:Jocelynlau007@gmail.com" class="btn btn--footer-primary">
            Send an Email
          </a>
          <a
            href="https://www.linkedin.com/in/jocelyn-lau-4546b128b/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--footer-outline"
          >
            Connect on LinkedIn ↗
          </a>
        </div>
      </div>
    </div>

    <div class="site-footer__wordmark">
      <Wordmark variant="footer" />
    </div>

    <div class="site-footer__bottom">
      <p>© {new Date().getFullYear()} Jocelyn Lau · International Business Management, BINUS University</p>
      <a href="#main-content" class="site-footer__backtop">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--ink);
    color: var(--surface);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-xl);
    align-items: start;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid rgba(245, 239, 198, 0.16);
  }

  .site-footer__eyebrow {
    color: var(--blue);
    margin-bottom: var(--space-xs);
  }

  .site-footer__heading {
    color: var(--surface);
    font-size: var(--step-4);
    margin-bottom: var(--space-sm);
    max-width: 16ch;
  }

  .site-footer__sub {
    color: rgba(252, 251, 244, 0.78);
    max-width: 44ch;
    font-size: var(--step-0);
  }

  .site-footer__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .site-footer__contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgba(245, 239, 198, 0.14);
  }

  .site-footer__label {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--blue);
    font-weight: 600;
  }

  .site-footer__value {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--cream);
    word-break: break-word;
  }

  .site-footer__value:hover {
    color: var(--blue);
  }

  .site-footer__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-2xs);
  }

  .btn--footer-primary {
    background-color: var(--cream);
    color: var(--ink);
    border-color: var(--cream);
  }

  .btn--footer-primary:hover {
    background-color: var(--blue);
    border-color: var(--blue);
    color: var(--ink);
  }

  .btn--footer-outline {
    background-color: transparent;
    color: var(--cream);
    border-color: rgba(245, 239, 198, 0.35);
  }

  .btn--footer-outline:hover {
    border-color: var(--cream);
    background-color: rgba(245, 239, 198, 0.08);
  }

  .site-footer__wordmark {
    padding-block: var(--space-xs);
    border-bottom: 1px solid rgba(245, 239, 198, 0.16);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--step--1);
    color: rgba(252, 251, 244, 0.68);
  }

  .site-footer__backtop {
    color: var(--cream);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-footer__backtop:hover {
    color: var(--blue);
  }

  @media (max-width: 860px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
